theme = Gypsum
window-padding-balance = true
font-family = monospace
font-family-italic = MonaspiceRn Nerd Font
font-size = 12
font-feature = "ss01"
font-feature = "ss02"
font-feature = "ss03"
font-feature = "ss04"
font-feature = "ss09"
font-feature = "liga"

keybind = ctrl+shift++=increase_font_size:1
keybind = ctrl+==set_font_size:11
keybind = ctrl+0=set_font_size:11
# keybind = shift+enter=text:\x1b\r
